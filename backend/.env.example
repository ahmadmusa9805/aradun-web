# Copy to backend/.env; never put real credentials in this example.
APP_ENV=development
APP_URL=http://127.0.0.1:3000
ALLOWED_ORIGINS=http://127.0.0.1:3000
PORT=4000

# Set your own local/Docker/Atlas URI here in the ignored backend/.env when needed.
MONGODB_URI=mongodb://127.0.0.1:27017/aradun_development?replicaSet=rs0
MONGODB_DB_NAME=aradun_development
# Atlas also uses MONGODB_URI, with mongodb+srv:// and the matching isolated DB name.
# Match your actual replica-set name. Native/Docker/Atlas must support transactions.
DB_MAX_POOL_SIZE=5
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_WAIT_QUEUE_TIMEOUT_MS=2000

# Email is disabled by default. Owner selected Resend; credentials remain backend-only.
EMAIL_PROVIDER=disabled
OUTBOX_MODE=disabled
# To validate only: npm run email:check --workspace @aradun/backend
# To send ONE explicit owner test: npm run email:test --workspace @aradun/backend
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=<private sending key>
# EMAIL_FROM=ARADUN <verified-sender@your-domain.example>
# EMAIL_REPLY_TO=reply@your-domain.example
# CONTACT_NOTIFICATION_EMAIL=reviewed-staff-inbox@your-domain.example
# OUTBOX_MODE=resend requires JOB_TRIGGER_SECRET, enabled intake and exactly one reviewed staff ID.
# Development/staging redirect ALL messages to CONTACT_NOTIFICATION_EMAIL and prefix [TEST].
# Hosted activation remains gated; this example does not send or schedule mail.
# JOB_TRIGGER_SECRET is backend-only; no real value belongs in this example.
ANALYTICS_ENABLED=false

# Required for shared catalog limits; backend-only canonical base64url, >=32 random bytes.
# RATE_LIMIT_HASH_SECRET=

# Local identity is disabled until reviewed secrets, limits, indexes and provisioning exist.
AUTH_PROVIDER=disabled
# AUTH_SESSION_SECRET=
# AUTH_LOGIN_LIMIT=
# AUTH_LOGIN_WINDOW_SECONDS=

# M03-03 local security remains explicitly disabled; never reuse session/limiter keys.
AUTH_SECURITY_ENABLED=false
# Owner-requested temporary local account-view exception; refused in hosted environments.
# AUTH_LOCAL_PASSWORD_ONLY=false
# AUTH_FACTOR_SEALING_KEY=<private canonical base64url random key of at least 32 bytes>

# Lifecycle operations use a separately reviewed ignored .env.operations, never these application defaults.
# ENABLE_LOCAL_STAFF_LIFECYCLE=false
# ALLOW_LOCAL_STAFF_BOOTSTRAP=false
# DB_OPERATIONS_URI=<separate approved local operational target; no application fallback>

# Public intake is disabled until the actual privacy notice and reviewed indexes are ready.
PUBLIC_INTAKE_ENABLED=false
# PRIVACY_NOTICE_VERSION=owner-approved-version
# INTAKE_STAFF_RECIPIENT_IDS=reviewed-active-admin-or-sales-id

# Public inquiry delivery without staff/dashboard setup (explicitly enable only after review)
# INTAKE_NOTIFICATION_MODE=inbox
# PUBLIC_INTAKE_ENABLED=true
# EMAIL_PROVIDER=resend
# OUTBOX_MODE=resend
# PRIVACY_NOTICE_VERSION=<reviewed-policy-version>
