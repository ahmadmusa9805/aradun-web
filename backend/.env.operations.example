# One-time development database operations only; copy to ignored .env.operations.
# Use a separate Atlas database user scoped to aradun_development.
# Never copy runtime credentials automatically or paste the operational URI into chat.
APP_ENV=development
MONGODB_DB_NAME=aradun_development
DB_OPERATIONS_URI=
# Fill privately with that user's Atlas URI, selecting /aradun_development.
# This file neither arms staff bootstrap nor enables forms/email.
