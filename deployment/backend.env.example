# Review template only; this deliberately has no working credentials.
NODE_ENV=production
APP_ENV=production
PORT=4000
APP_URL=https://replace-with-approved-site.example.invalid
ALLOWED_ORIGINS=https://replace-with-approved-site.example.invalid
MONGODB_URI=
MONGODB_DB_NAME=aradun_production
DB_MAX_POOL_SIZE=5
DB_SERVER_SELECTION_TIMEOUT_MS=5000
DB_WAIT_QUEUE_TIMEOUT_MS=2000
RATE_LIMIT_HASH_SECRET=
AUTH_PROVIDER=disabled
AUTH_SECURITY_ENABLED=false
PUBLIC_INTAKE_ENABLED=true
INTAKE_NOTIFICATION_MODE=inbox
PRIVACY_NOTICE_VERSION=
JOB_TRIGGER_SECRET=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
CONTACT_NOTIFICATION_EMAIL=
EMAIL_PROVIDER=resend
OUTBOX_MODE=resend
ANALYTICS_ENABLED=false
# PUBLIC_RELEASE_ID=<same separately approved release ID as frontend>
# An ID alone never publishes draft catalog records.
# Production must never reuse the development database or local bootstrap arming.
# Runtime processes stay on loopback behind the chosen HTTPS reverse proxy.
