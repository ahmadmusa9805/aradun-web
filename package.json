{
  "name": "aradun",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "packageManager": "npm@11.19.1",
  "engines": {
    "node": ">=24.22.2 <25",
    "npm": ">=11.19.1 <12"
  },
  "overrides": {
    "minimatch": "11.0.1"
  },
  "scripts": {
    "mongodb": "node scripts/mongodb-local.mjs",
    "frontend": "npm run dev --workspace @aradun/frontend",
    "backend": "npm run dev --workspace @aradun/backend",
    "dev:frontend": "npm run dev --workspace @aradun/frontend",
    "dev:backend": "npm run dev --workspace @aradun/backend",
    "build": "npm run catalog:check && npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces && npm run typecheck:tests",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "lint": "eslint frontend backend tests scripts *.ts eslint.config.mjs && npm run check:boundaries",
    "test": "vitest run",
    "test:unit": "vitest run --project backend --exclude backend/tests/mongo.test.ts --exclude backend/tests/audit.test.ts --exclude backend/tests/database.test.ts",
    "test:db": "vitest run --project backend backend/tests/mongo.test.ts backend/tests/audit.test.ts backend/tests/database.test.ts",
    "db:indexes": "npm run db:indexes --workspace @aradun/backend --",
    "intake:check": "npm run intake:check --workspace @aradun/backend",
    "deploy:check": "node --import tsx scripts/check-deployment.mjs",
    "test:browser": "playwright test",
    "test:install-browser": "node scripts/install-test-browser.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:secrets": "node scripts/check-public-secrets.mjs",
    "format": "prettier --write package.json tsconfig.json eslint.config.mjs .prettierrc.json frontend backend tests *.config.ts scripts/*.mjs",
    "format:check": "prettier --check package.json tsconfig.json eslint.config.mjs .prettierrc.json frontend backend tests *.config.ts scripts/*.mjs",
    "catalog:check": "node --import tsx backend/scripts/catalog/check.ts",
    "staff:access": "npm run staff:access --workspace @aradun/backend --",
    "staff:setup": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy RemoteSigned -File scripts/setup-owner.ps1",
    "staff:setup:atlas": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy RemoteSigned -File scripts/setup-owner.ps1 -Atlas"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.4.5",
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "globals": "16.4.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
